# Copy to .env and adjust. All variables are optional; defaults shown.
# Every setting maps to churn.config.Settings (prefix CHURN_).

# --- paths ---
# CHURN_DATA_PATH=data/Telco-Customer-Churn.csv
# CHURN_MODELS_DIR=models
# CHURN_PREDICTION_LOG_PATH=logs/predictions.jsonl   # unset = no audit log

# --- model selection ---
# CHURN_MODEL_VERSION=latest          # or a specific registry version id
# CHURN_RANDOM_STATE=42
# CHURN_TEST_SIZE=0.2
# CHURN_CV_FOLDS=5
# CHURN_SELECTION_METRIC=roc_auc
# CHURN_CALIBRATION=auto              # auto | sigmoid | isotonic | none

# --- service ---
# CHURN_API_URL=http://localhost:8000 # set for the dashboard to call the API
# CHURN_API_BATCH_LIMIT=1000
# CHURN_LOG_JSON=false                # true in containers
